#. settings-schema.json->do_autohide->description
#. applet.js:546
msgid "Autohide"
msgstr "Auto-amagar"

#. metadata.json->description
msgid ""
"hide a few applet to have a neater panel, and make them show up again by a "
"click"
msgstr ""
"oculteu unes quantes miniaplicacions per a tenir un tauler més net, i feu "
"que es mostri de nou en rebre un clic"

#. metadata.json->name
msgid "Drawer (show/hide applets)"
msgstr "Calaix (mostra/amaga miniaplicacions)"

#. settings-schema.json->head->description
msgid "Settings for show-hide-applets@mohammad-sn"
msgstr "Configuració de show-hide-applets@mohammad-sn"

#. settings-schema.json->do_autohide->tooltip
msgid ""
"Check it if you want to hide applets automatically, unless you should click "
"on applet to do so.\n"
"Its status can be changed by middle-clicking on this applet."
msgstr ""
"Marqueu si voleu amagar miniaplicacions automàticament o si cal clicar-les "
"d'una en una.\n"
"El seu estat pot ser canviat utilitzant el clic del mig en aquesta "
"miniaplicació."

#. settings-schema.json->hidetime->units
msgid "seconds"
msgstr "segons"

#. settings-schema.json->hidetime->description
msgid "Autohide after "
msgstr "Auto-amagar després de "

#. settings-schema.json->hoveractivates->description
#, fuzzy
msgid "Show on hover"
msgstr "Auto-amagar en passar el cursor per sobre"

#. settings-schema.json->hoveractivates->tooltip
msgid "show applets on mouse hover"
msgstr "mostrar miniaplicacions en passar el cursor per sobre"

#. settings-schema.json->hoveractivateshide->description
msgid "Hide on hovering again"
msgstr "Ocultar de nou en passar el cursor per sobre"

#. settings-schema.json->hoveractivateshide->tooltip
msgid "toggle visibility of applets on mouse hover"
msgstr ""
"activar/desactivar visibilitat de les miniaplicacions en passar el cursor "
"per sobre"

#. settings-schema.json->hovertime->units
msgid "miliseconds"
msgstr "mil·lisegons"

#. settings-schema.json->hovertime->description
#, fuzzy
msgid "Hover shows/hides after "
msgstr "El hover s'activa/desactiva després de "

#. settings-schema.json->autohiders->description
msgid "Autohide reshowing applets"
msgstr "Auto-amagar la mostra consecutiva de miniaplicacions"

#. settings-schema.json->hideuntilseparator->description
msgid "Only hide until next separator"
msgstr "Amaga només fins al proper separador"

#. settings-schema.json->hideuntilseparator->tooltip
msgid "Only hide everything until the next separator element occurs."
msgstr "Només ho amaga tot fins que arriba el següent element separador."

